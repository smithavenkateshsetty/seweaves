# Everything here is optional. With none of it set the app still runs,
# using a local SQLite file and local disk for photos.

ADMIN_PASSWORD=pick-something-long-and-random
SHOP_WHATSAPP=918073387456
PORT=3000

# Persistence — Neon Postgres. Use the POOLED connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Photos — Cloudinary (free, no card). Takes precedence over R2 if both are set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=seweaves

# Photos — Cloudflare R2 (free, needs a card on file)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://images.yourdomain.com
